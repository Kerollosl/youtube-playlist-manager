{
  "manifest_version": 3,
  "name": "YouTube Multiselect (Custom)",
  "version": "1.1.0",
  "description": "Multiselect inside YouTube: copy selected links as plain text and move videos with verified copies and recovery.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle multiselect in YouTube"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
