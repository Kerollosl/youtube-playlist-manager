{
  "manifest_version": 3,
  "name": "YouTube Multiselect",
  "version": "1.6.0",
  "description": "Fast YouTube playlist multiselect with batched saves, verified moves, plain-text links, and recovery.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle multiselect in YouTube"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "src/page.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui.css"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
